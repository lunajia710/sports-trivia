<div id="question_card">
  <div class="play-trivia-page">

    <nav class="navbar bg-white border-bottom">
      <div class="container">

        <a href="#" class="navbar-brand">
          Trivia Decks
        </a>

        <a href="#" class="btn btn-success">
          End Game
        </a>

      </div>
    </nav>

    <main class="container py-5">
      <div class="m-4">
        <h3>Questions: <%= @current %> / <%= @total %></h3>
        <div class="progress" role="progressbar" aria-label="Question progress" aria-valuenow="<%= @progress %>" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar" style="width: <%= @progress%>%;">
          </div>
        </div>
      </div>

      <div class="question-heading">
        <h1>
          <%= @question.question %>
        </h1>
      </div>

      <div class="answers">

        <div class="answer-card">
          <div class="answer-card-body">
            <p class="answer">
              <% @question.options.each do |option| %>
                <%= simple_form_for [@round, Answer.new] do |f| %>
                  <%= f.input :question_id, as: :hidden, input_html: { value: @question.id } %>
                  <%= f.input :response,    as: :hidden, input_html: { value: option.response } %>
                  <%= f.button :submit, option.response, class: "btn btn-outline-success w-100" %>
                <% end %>
              <% end %>
            </p>
          </div>
        </div>
      </div>
    </main>
  </div>

</div>
