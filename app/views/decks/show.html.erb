<div class="leaderboard-page">

  <nav class="navbar bg-white border-bottom">
    <div class="container">

      <%# <a href="#" class="navbar-brand">
        <%# Trivia Decks %>
      <%# </a> %>
      <%= link_to "Trivia Decks", root_path, class: "navbar-brand" %>

    </div>
  </nav>


  <main class="container py-5">

    <div class="leaderboard-heading text-center mb-4">
      <h1><%= @deck.title %></h1>
      <div class="leaderboard-card m-4 p-4">
        Hi <%= @last_play.user.username %>, you have scored
        <%= @last_play.score %> and ranked <%= @rank %> for this deck.
      </div>

      <div class="d-flex justify-content-center gap-2">
        <button class="btn btn-outline-success">
          Share
        </button>
          <button class="btn btn-success">
          👍 Like
        </button>
      </div>
      <h2 class="text-muted m-4">
        Leaderboard (Top 10 Plays)
      </h2>
    </div>
    <div class="leaderboard-card">

      <table class="table table-hover mb-0">

        <thead>
          <tr>
            <th>Rank</th>
            <th>Player</th>
            <th>Score</th>
          </tr>
        </thead>
        <% prev_score = nil %>
        <% prev_rank = 0 %>
        <% @leaderboard.each_with_index do |round, index| %>
          <% rank = round.score == prev_score ? prev_rank : index + 1 %>
          <% prev_score = round.score %>
          <% prev_rank = rank %>
        <tbody>
          <tr>
            <td><%= rank %></td>
            <td><%= round.user.username %></td>
            <td><%= round.score %></td>
          </tr>

        </tbody>
        <% end %>

      </table>

    </div>

  </main>

</div>
