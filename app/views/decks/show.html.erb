<div class="leaderboard-page">

  <main class="container py-5">
    <div class="leaderboard-heading text-center mb-4">
      <h1><%= @deck.title %></h1>
      <% if flash[:confetti] %>
        <div data-controller="confetti"></div>
      <% end %>
      <div class="d-flex justify-content-center gap-2">
        <button class="btn btn-outline-success">
          Share
        </button>
          <button class="btn btn-success">
          👍 Like
        </button>
      </div>
      <div class="bg-success text-white m-4 p-4 rounded-5">
        Hi <%= @last_play.user.username %>, your recent score is
        <%= @last_play.score %> and rank <%= @rank %> among all plays.
      </div>
    </div>
    <h2 class="text-muted mb-3 mx-auto">
      Leaderboard (Top 10 Plays)
    </h2>
    <div class="leaderboard-card">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Rank</th>
            <th>Player</th>
            <th>Score</th>
          </tr>
        </thead>
        <% prev_score = nil %>
        <% prev_rank = 0 %>
        <% @leaderboard.each_with_index do |round, index| %>
          <% rank = round.score == prev_score ? prev_rank : index + 1 %>
          <% prev_score = round.score %>
          <% prev_rank = rank %>
        <tbody>
          <tr>
            <td><%= rank %></td>
            <td><%= round.user.username %></td>
            <td><%= round.score %></td>
          </tr>

        </tbody>
        <% end %>

      </table>
    </div>

  </main>

</div>
