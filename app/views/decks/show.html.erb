<div class="leaderboard-page">

  <main class="container py-5">
    <div class="leaderboard-heading text-center mb-4">
      <h1><%= @deck.title %></h1>
      <% if flash[:confetti] %>
        <div data-controller="confetti"></div>
      <% end %>
      <div class="d-flex justify-content-center gap-2">
        <div data-controller="clipboard" data-clipboard-text-value="<%= deck_url(@deck) %>">
          <button class="btn btn-outline-success" data-clipboard-target="button" data-action="clipboard#copy">
            <i class="fa-solid fa-share"></i> Share
            </button>
        </div>
          <button class="btn btn-success">
          👍 Like
        </button>
      </div>
      <% if @last_play %>
        <div class="bg-success text-white m-4 p-4 rounded-5">
          Hi <%= @last_play.user.username %>, your recent score is
          <%= @last_play.score %> and rank <%= @rank %> among all plays.
        </div>
      <% end %>
    </div>
    <h2 class="text-muted mb-3 mx-auto">
      Leaderboard (Top 10 Plays)
    </h2>
    <div class="leaderboard-card">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Rank</th>
            <th>Player</th>
            <th>Score</th>
          </tr>
        </thead>
        <% prev_score = nil %>
        <% prev_rank = 0 %>
        <tbody>
          <% @leaderboard.each_with_index do |round, index| %>
            <% rank = round.score == prev_score ? prev_rank : index + 1 %>
            <% prev_score = round.score %>
            <% prev_rank = rank %>
            <tr>
              <td><%= rank %></td>
              <td><%= round.user.username %></td>
              <td><%= round.score %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </main>

</div>
