<div class="home-page">
  <main class="container py-5">
    <div>
      <%= button_to "New Trivia AI Generator", new_deck_path, method: :get, class: "btn btn-success" %>
    </div>

    <div class="page-intro">
      <h1>Search for Decks!</h1>

      <p>
        Choose a sports trivia deck and start playing.
      </p>

      <div class="input-group">
        <input
          type="text"
          class="form-control"
          placeholder="Search for a deck"
        >

        <button class="btn btn-success">
          Search
        </button>
      </div>
    </div>


    <div class="decks-section">
      <% unless current_user.nil? %>
          <div class="row">
            <h2>My Decks</h2>
            <% current_user.decks.each do |deck| %>
              <div class="col-12 col-md-6 mb-3">
                <div class="deck-card h-100">
                  <div class="deck-content">
                    <h3 class="mb-0"> <%= link_to deck.title, deck_path(deck) %></h3>
                    <p class="mb-0"><%= deck.questions.count %> questions</p>
                  </div>
                <div class="deck-actions d-flex justify-content-between">
                  <%= button_to deck_rounds_path(deck), method: :post, class: "btn btn-success rounded-circle" do %>
                    <i class="fa-solid fa-play"></i>
                  <% end %>
                  <% if deck.chat.present? %>
                    <%= link_to chat_path(deck.chat), class: "btn btn-primary rounded-circle text-white" do %>
                      <i class="fa-solid fa-pen"></i>
                    <% end %>
                  <% end %>
                </div>
              </div>
              </div>
            <% end %>
          </div>
          </div>
      <% end %>
      <div class="decks-section">
      <h2>Trending Decks (Top 5)</h2>
      <div class="row">
        <% @top_decks.each do |deck| %>
          <div class="col-12 col-md-6 mb-3">
            <div class="deck-card h-100">
              <div class="deck-content">
                <h3 class="mb-0"> <%= link_to deck.title, deck_path(deck) %></h3>
                <p class="mb-0"><%= deck.questions.count %> questions</p>
              </div>
              <div class="deck-actions justify-content-between">
                <%= button_to deck_rounds_path(deck), method: :post, class: "btn btn-success rounded-circle" do %>
                  <i class="fa-solid fa-play"></i>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>
