<div class="my-decks-page">

  <nav class="navbar bg-white border-bottom">
    <div class="container">

      <a href="#" class="navbar-brand">
        Trivia Decks
      </a>

      <div>
        <a href="#" class="btn btn-success">
          Log out
        </a>
      </div>

    </div>
  </nav>


  <main class="container py-5">

    <div class="page-intro">
      <h1>My Trivia Decks</h1>

      <p>
        Choose your deck and start playing.
      </p>
    </div>

    <div class="decks-section">

      <div class="row">
        <% if @decks.any? %>
          <% @decks.each do |deck| %>
            <div class="col-12 col-md-6">
              <div class="deck-card">

                <div class="deck-image">
                  🏀 🐐
                </div>

                <div class="deck-content">
                  <h3>NBA GOATS</h3>
                  <p>20 questions</p>
                </div>

                <div class="deck-actions">
                  <a href="#" class="action-btn">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </a>

                  <a href="#" class="action-btn">
                    <i class="fa-solid fa-share-nodes"></i>
                  </a>
                  <a href="#" class="action-btn delete-btn">
                    <i class="fa-solid fa-trash"></i>
                </a>
              </div>
            </div>
          <% end %>
        </div>


        <div class="col-12 col-md-6">
          <div class="deck-card">

            <div class="deck-image">
              🎾 🔥
            </div>

            <div class="deck-content">
              <h3>Greatest Rivals - Tennis</h3>
              <p>15 questions</p>
            </div>

            <div class="deck-actions">
              <a href="#" class="action-btn">
                <i class="fa-solid fa-pen-to-square"></i>
              </a>
              <a href="#" class="action-btn">
                <i class="fa-solid fa-share-nodes"></i>
              </a>
              <a href="#" class="action-btn delete-btn">
                <i class="fa-solid fa-trash"></i>
              </a>
            </div>
          </div>
        </div>


        <div class="col-12 col-md-6">
          <div class="deck-card">

            <div class="deck-image">
              ⚽ 🏆
            </div>

            <div class="deck-content">
              <h3>World Cup Champions</h3>
              <p>25 questions</p>
            </div>

            <div class="deck-actions">
              <a href="#" class="action-btn">
                <i class="fa-solid fa-pen-to-square"></i>
              </a>

              <a href="#" class="action-btn">
                <i class="fa-solid fa-share-nodes"></i>
              </a>
              <a href="#" class="action-btn delete-btn">
                <i class="fa-solid fa-trash"></i>
              </a>
            </div>
          </div>
        </div>


        <div class="col-12 col-md-6">
          <div class="deck-card">

            <div class="deck-image">
              🏉 👊🏼
            </div>

            <div class="deck-content">
              <h3>NRL - Best Biffs</h3>
              <p>18 questions</p>
            </div>

            <div class="deck-actions">
              <a href="#" class="action-btn">
                <i class="fa-solid fa-pen-to-square"></i>
              </a>

              <a href="#" class="action-btn">
                <i class="fa-solid fa-share-nodes"></i>
              </a>
              <a href="#" class="action-btn delete-btn">
                <i class="fa-solid fa-trash"></i>
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>

  </main>

</div>
