<%= turbo_stream.update "question_card" do %>
  <div class="play-trivia-page">
    <main class="container py-5">

      <div class="question-heading">
        <h1>
          <%= @question.question %>
        </h1>
      </div>

      <div class="answers">

        <div class="answer-card">
          <div class="answer-card-body">
            <p class="answer">
              <% @question.options.each do |option| %>
                <div class="card m-3">
                  <button class="btn w-100 <%= option.is_solution ? 'btn-success' : 'btn-danger'%> " disabled>
                    <%= option.response %>
                  </button>
                </div>
              <% end %>
            </p>
          </div>
        </div>
      </div>
      <div>
        <%= link_to "Next", round_path(@round), data: { turbo: false }, class: "btn btn-primary m-3" %>
      </div>
    </main>
  </div>
<% end %>
