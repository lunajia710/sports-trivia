<%= turbo_stream.update "question_card" do %>
  <div class="play-trivia-page">

    <nav class="navbar bg-white border-bottom">
      <div class="container">
        <%= link_to "Trivia Decks", root_path, class: "navbar-brand" %>
        <%= link_to "End Game", decks_path, class: "btn btn-success" %>
      </div>
    </nav>

    <main class="container py-5">

      <div class="question-heading">
        <h1>
          <%= @question.question %>
        </h1>
      </div>

      <div class="answers">

        <div class="answer-card">
          <div class="answer-card-body">
            <p class="answer">
              <% @question.options.each do |option| %>
                <% chosen = option.response == @answer.response %>
                <div class="card m-3">
                  <% if chosen %>
                    <button class="btn w-100 <%= option.is_solution ? 'btn-success' : 'btn-danger'%> " disabled>
                      <%= option.response %>
                    </button>
                  <% else %>
                    <button class="btn w-100 <%= option.is_solution ? 'btn-success' : 'btn-light'%> " disabled>
                    <%= option.response %>
                  </button>
                  <% end %>
                </div>
              <% end %>
            </p>
          </div>
        </div>
      </div>
      <div>
        <%= link_to "Next", round_path(@round), data: { turbo: false }, class: "btn btn-primary m-3" %>
      </div>
    </main>
  </div>
<% end %>
