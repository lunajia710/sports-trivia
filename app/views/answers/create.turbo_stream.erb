<%= turbo_stream.update "question_card" do %>
  <div class="play-trivia-page">

    <main class="container py-5">
      <div class="m-4">
        <h3>Questions: <%= @current %> / <%= @total %></h3>
        <div class="progress" role="progressbar" aria-label="Question progress" aria-valuenow="<%= @progress %>" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar" style="width: <%= @progress%>%;">
          </div>
        </div>
      </div>
      <div class="question-heading">
        <h1>
          <%= @question.question %>
        </h1>
      </div>

      <div class="answers">

        <div class="answer-card">
          <div class="answer-card-body">
            <div class="answer">
              <% @question.options.each do |option| %>
                <% chosen = option.response == @answer.response %>
                <div class="card m-3">
                  <% if chosen %>
                    <button class="btn w-100 <%= option.is_solution ? 'btn-success' : 'btn-danger'%> " disabled>
                      <%= option.response %>
                    </button>
                  <% else %>
                    <button class="btn w-100 <%= option.is_solution ? 'btn-success' : 'btn-light'%> " disabled>
                    <%= option.response %>
                  </button>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      <div>
        <%= link_to "Next", round_path(@round), data: { turbo: false }, class: "btn btn-primary m-3" %>
      </div>
    </main>
  </div>
<% end %>

<%= turbo_stream.append "sounds" do %>
  <audio autoplay src="<%= @answer.correct? ? '/sounds/correct.mp3' : '/sounds/wrong.mp3' %>"></audio>
<% end %>
