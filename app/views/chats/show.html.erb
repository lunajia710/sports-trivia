<div class="chat-page">

  <!-- TOP: chat window -->
  <section class="chat-window m-4">
    <h1><%= @deck.title %></h1>

    <div id="messages" class="messages">
      <% @chat.messages.where(role: %w[user assistant]).each do |message| %>
        <div class="d-flex <%= message.role == "user" ? "justify-content-end" : "justify-content-start" %> mb-2">
          <div class="<%= message.role == "user" ? "bg-success text-white" : "bg-white text-primary" %> px-3 py-3 rounded-5">
            <%= message.content %>
          </div>
        </div>
      <% end %>
    </div>

    <%= simple_form_for [@chat, @message] do |f| %>
      <%= f.input :content, label: false, placeholder: "Refine your deck — e.g. make them harder", required: true %>
      <%= f.button :submit, "Ask AI", class: "btn btn-primary" %>
    <% end %>
  </section>

  <!-- BOTTOM: horizontal scroll gallery -->
  <section class="deck-gallery-section m-4" data-controller="carousel">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="mb-0">Preview</h2>
    <span data-carousel-target="counter" class="text-muted"></span>
  </div>

  <% @deck.questions.each do |question| %>
    <div class="card mb-2" data-carousel-target="card">
      <div class="card-body">
        <strong class="d-block mb-2"><%= question.question %></strong>
        <ul class="mb-0 ps-3">
          <% question.options.each do |option| %>
            <li class="<%= 'text-success fw-bold' if option.is_solution %>">
              <%= option.response %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="d-flex justify-content-between m-4">
    <button class="btn btn-outline-secondary" data-action="carousel#prev">← Prev</button>
    <button class="btn btn-outline-secondary" data-action="carousel#next">Next →</button>
  </div>

  <%= button_to "Confirm", confirm_chat_path(@chat), method: :post,
        class: "btn btn-success w-100 mt-3" %>
</section>

</div>
